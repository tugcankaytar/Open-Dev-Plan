# --- User data (never commit meeting recordings / transcripts / DB) ---
data/
*.db
*.db-wal
*.db-shm
audio/
recordings/
# Anchored to repo root — a bare "models/" here would also match (and
# silently swallow from every commit) our own src/odp/models/ Python
# package, which is exactly what happened before this line was fixed.
/models/
*.jsonl
!evals/golden/*.jsonl
training/checkpoints/
training/output/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
*.swp

# --- Local config / secrets ---
.env
.env.*
!.env.example
